# cp .env.example .env   (server/.env is git-ignored; Bun loads it automatically from this folder)
# Without a key every Sketchling comes from the offline generator, which still works fine.
ANTHROPIC_API_KEY=
# Vision model for personas. Empty = claude-opus-5-5. Faster alternatives: claude-sonnet-5-5, claude-haiku-5-5
SKETCHLINGS_MODEL=
# Optional: base of the QR join URL when the LAN IP guess is wrong, e.g. http://192.168.1.20:8787
PUBLIC_URL=
# Optional: Anthropic API base URL (default https://api.anthropic.com). The shell's ANTHROPIC_BASE_URL is ignored on purpose.
SKETCHLINGS_ANTHROPIC_BASE_URL=
