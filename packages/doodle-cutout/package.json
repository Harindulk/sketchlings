{
  "name": "doodle-cutout",
  "version": "0.2.0",
  "description": "Cut a drawing out of a phone photo of paper: a clean transparent sticker sprite. Classic image processing, zero dependencies, browser (main thread or Web Worker), Node and Bun.",
  "keywords": [
    "drawing",
    "doodle",
    "sketch",
    "cutout",
    "background-removal",
    "sprite",
    "sticker",
    "image-processing",
    "computer-vision",
    "morphology",
    "web-worker",
    "kids"
  ],
  "license": "MIT",
  "author": "StarFun Games",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harindulk/doodle-cutout.git"
  },
  "homepage": "https://github.com/Harindulk/doodle-cutout#readme",
  "bugs": {
    "url": "https://github.com/Harindulk/doodle-cutout/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "demo": "bun examples/demo.html",
    "images": "bun scripts/demo.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && bun test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
