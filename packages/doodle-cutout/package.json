{
  "name": "doodle-cutout",
  "version": "0.1.0",
  "description": "Turn a phone photo of a drawing on paper into a clean transparent sticker sprite. Zero dependencies, browser + Node/Bun.",
  "keywords": [
    "drawing",
    "doodle",
    "sketch",
    "cutout",
    "background-removal",
    "sprite",
    "sticker",
    "image-processing",
    "computer-vision",
    "kids"
  ],
  "license": "MIT",
  "author": "StarFun Games",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "demo": "bun scripts/demo.ts",
    "prepublishOnly": "npm run typecheck && bun test && npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
